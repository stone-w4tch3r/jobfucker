        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "external_id": {
          "title": "External Id",
          "type": "string"
        },
        "fetched_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fetched At"
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generated At"
        },
        "letter_stale": {
          "title": "Letter Stale",
          "type": "boolean"
        },
        "pipeline_id": {
          "title": "Pipeline Id",
          "type": "integer"
        },
        "salary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
