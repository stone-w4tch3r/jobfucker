        "title": {
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "user_edited_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
