{
  // Self-contained project settings (loaded because this project is its own
  // workspace folder in ../../../docs.code-workspace). Heavy tool config lives
  // in pyproject.toml ([tool.ruff], [tool.basedpyright]); these settings only
  // wire the VS Code extensions to this project.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "ruff.enable": true,
  "ruff.lint.enable": true,
  "ruff.format.enable": true,
  "ruff.configurationPreference": "filesystemFirst",
  "basedpyright.analysis.configFilePath": "./pyproject.toml",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "cSpell.words": [
    "jobfucker"
  ]
}